  "rules": [
    {
      "id": "r_rg1",
      "name": "RG1",
      "text": "Une position ne peut être ouverte que si la mise est inférieure ou égale au solde du portefeuille ; le portefeuille est alors débité.",
      "sql": ""
    },
    {
      "id": "r_rg2",
      "name": "RG2",
      "text": "Les prix d'entrée et de sortie d'une position sont imposés par le serveur : dernière cotation du token au moment de l'action.",
      "sql": ""
    },
    {
      "id": "r_rg3",
      "name": "RG3",
      "text": "À la fermeture, pnl = mise × (prix_sortie / prix_entree − 1) ; le portefeuille est crédité de mise + pnl et la position devient non modifiable.",
      "sql": ""
    },
    {
      "id": "r_rg4",
      "name": "RG4",
      "text": "Impossible d'ouvrir une position sur un token suspendu.",
      "sql": ""
    },
    {
      "id": "r_rg5",
      "name": "RG5",
      "text": "Un joueur ne peut avoir qu'une seule position ouverte par token.",
      "sql": ""
    }
  ],
